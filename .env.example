# Optional API keys. Copy to .env and fill in. Without them, the OANDA and
# Twelve Data sources are skipped in the fallback chain.
OANDA_API_KEY=
# "practice" (default) or "live"
OANDA_ENV=practice
TWELVEDATA_API_KEY=

# --- Chart photo web app (webapp/server.py) ---
# Required: Claude API key. Stays on the server; never put it in the frontend.
ANTHROPIC_API_KEY=
# Optional tuning (defaults shown)
VISION_MODEL=claude-opus-5-5
VISION_EFFORT=high
MIN_CONFIDENCE=60
# Optional protection when the server is reachable from the internet
APP_ACCESS_TOKEN=
RATE_LIMIT_PER_HOUR=30
# Optional: serve HTTPS directly (needed to install the PWA on a phone)
TLS_CERT=
TLS_KEY=
